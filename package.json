{
  "name": "dblet",
  "version": "0.0.1",
  "description": "Homemade web application toolkit for me.",
  "license": "MIT",
  "author": "Joe-noh",
  "repository": {
    "url": "https://github.com/Joe-noh/dblet"
  },
  "bin": {
    "dblet": "./dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "workerd": "./dist/index.workerd.mjs",
      "default": "./dist/index.mjs"
    },
    "./kysely": {
      "types": "./dist/kysely.d.mts",
      "default": "./dist/kysely.mjs"
    },
    "./vitest": {
      "types": "./dist/vitest.d.mts",
      "default": "./dist/vitest.mjs"
    },
    "./vitest-global": {
      "types": "./dist/vitest-global.d.mts",
      "default": "./dist/vitest-global.mjs"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "tsdown",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "tsc --noEmit",
    "test": "pnpm build && vitest"
  },
  "dependencies": {
    "jiti": "^2.7.0",
    "kysely": "^0.29.6",
    "kysely-codegen": "^0.20.0",
    "pg": "^8.23.1",
    "pg-connection-string": "^2.14.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "oxfmt": "^0.72.0",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "peerDependencies": {
    "vitest": ">=4"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.9.1"
}

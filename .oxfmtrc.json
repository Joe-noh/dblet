{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "ignorePatterns": ["**/dblet.d.ts"],
  "sortImports": {
    "newlinesBetween": false,
    "customGroups": [
      {
        "groupName": "alias",
        "elementNamePattern": ["@/**"]
      }
    ],
    "groups": ["builtin", "external", "alias", "parent", "sibling", "index", "unknown"]
  }
}
